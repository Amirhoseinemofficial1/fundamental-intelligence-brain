[Unit]
Description=V52 Realtime Fundamental Intelligence Production Supervisor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=v52fund
Group=v52fund
WorkingDirectory=/opt/v52-fundamental
EnvironmentFile=/etc/v52-fundamental.env
Environment=V52_PACKAGE_ROOT=/opt/v52-fundamental
Environment=PYTHONPATH=/opt/v52-fundamental/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/v52-fundamental/.venv/bin/python -m v52.diagnostics.preflight
ExecStart=/opt/v52-fundamental/.venv/bin/python -m v52.runtime.supervisor
Restart=on-failure
RestartSec=5
TimeoutStopSec=75
KillSignal=SIGTERM
KillMode=mixed
UMask=0027
LimitNOFILE=131072
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/v52-fundamental

[Install]
WantedBy=multi-user.target
